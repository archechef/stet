{
  "name": "stet-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/cli",
    "packages/vscode"
  ],
  "scripts": {
    "build": "tsc -b packages/core packages/cli && npm run build -w stet-vscode",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "biome check",
    "format": "biome check --write",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "package:vscode": "npm run package -w stet-vscode"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "^22.20.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "@vscode/vsce": {
      "minimatch": "11.0.5"
    }
  },
  "license": "MIT",
  "author": "Noah Tittelbach",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/archechef/stet.git"
  },
  "homepage": "https://github.com/archechef/stet#readme",
  "bugs": {
    "url": "https://github.com/archechef/stet/issues"
  }
}
