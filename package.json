{
  "name": "stet-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/cli",
    "packages/vscode"
  ],
  "scripts": {
    "build": "tsc -b packages/core packages/cli && npm run build -w stet-vscode",
    "test": "vitest run",
    "package:vscode": "npm run package -w stet-vscode"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
