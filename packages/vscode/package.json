{
  "name": "stet-vscode",
  "displayName": "Stet",
  "description": "Review AI-proposed changes to LaTeX and Typst projects: accept, reject, edit or comment on each change.",
  "version": "0.16.0",
  "publisher": "archechef",
  "license": "MIT",
  "author": "Noah Tittelbach",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#F6F1E4",
    "theme": "light"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "latex",
    "tex",
    "typst",
    "overleaf",
    "review",
    "proofreading",
    "ai",
    "agent",
    "claude",
    "codex",
    "mcp"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Stet runs git in your project and writes accepted changes to your files, so it only works in folders you trust."
    },
    "virtualWorkspaces": false
  },
  "activationEvents": [
    "workspaceContains:**/*.tex",
    "workspaceContains:**/*.typ"
  ],
  "scripts": {
    "build": "tsc -b ../core && tsc -p . && tsc -p tsconfig.webview.json && node esbuild.mjs",
    "package": "node -e \"for (const f of ['LICENSE','CHANGELOG.md']) require('fs').copyFileSync('../../'+f,f)\" && npm run build && vsce package --no-dependencies --allow-missing-repository -o stet-vscode.vsix",
    "test:integration": "node test/integration/run.mjs"
  },
  "dependencies": {
    "@stet/core": "0.16.0"
  },
  "devDependencies": {
    "@types/vscode": "~1.100.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "stet",
          "title": "Stet",
          "icon": "media/stet.svg"
        }
      ]
    },
    "views": {
      "stet": [
        {
          "id": "stet.review",
          "name": "Review",
          "icon": "media/stet.svg"
        },
        {
          "id": "stet.history",
          "name": "History",
          "icon": "media/stet.svg",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "stet.review",
        "contents": "Stet is not set up for this folder yet.\n[Set up project](command:stet.setup)\nStet keeps AI agents in their own workspace and lets you review each proposed change.",
        "when": "workspaceFolderCount > 0 && !stet.active && !stet.agentWorkspace"
      },
      {
        "view": "stet.review",
        "contents": "This folder is an AI agent's workspace. You review its changes in the window of your project, where its proposals arrive.\n[Open the project](command:stet.openAgentProject)",
        "when": "stet.agentWorkspace"
      },
      {
        "view": "stet.review",
        "contents": "Open the folder of your LaTeX or Typst project to use Stet.\n[Open Folder](command:vscode.openFolder)",
        "when": "workspaceFolderCount == 0"
      },
      {
        "view": "stet.review",
        "contents": "No agents yet. Create a workspace for an AI agent, then open it in the Claude desktop app, Claude Code or Codex.\n[New agent workspace](command:stet.newAgent)",
        "when": "stet.active && !stet.hasAgents"
      }
    ],
    "commands": [
      {
        "command": "stet.setup",
        "title": "Set up project",
        "category": "Stet",
        "icon": "$(add)"
      },
      {
        "command": "stet.newAgent",
        "title": "New agent workspace",
        "category": "Stet",
        "icon": "$(add)"
      },
      {
        "command": "stet.openAgentProject",
        "title": "Open the project of this agent workspace",
        "category": "Stet"
      },
      {
        "command": "stet.openAgent",
        "title": "Open agent workspace…",
        "category": "Stet",
        "icon": "$(folder-opened)"
      },
      {
        "command": "stet.copyAgentPath",
        "title": "Copy workspace path",
        "category": "Stet"
      },
      {
        "command": "stet.archiveAgent",
        "title": "Archive agent…",
        "category": "Stet"
      },
      {
        "command": "stet.refresh",
        "title": "Refresh",
        "category": "Stet",
        "icon": "$(refresh)"
      },
      {
        "command": "stet.doctor",
        "title": "Check setup",
        "category": "Stet",
        "icon": "$(pulse)"
      },
      {
        "command": "stet.finishReview",
        "title": "Finish review (commit accepted changes)",
        "category": "Stet",
        "icon": "$(git-commit)"
      },
      {
        "command": "stet.shareEdits",
        "title": "Share my edits with agents",
        "category": "Stet",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "stet.highlightOn",
        "title": "Highlight proposed text in green",
        "category": "Stet",
        "icon": "$(symbol-color)"
      },
      {
        "command": "stet.highlightOff",
        "title": "Show proposed text in theme colours",
        "category": "Stet",
        "icon": "$(paintcan)"
      },
      {
        "command": "stet.accept",
        "title": "Accept",
        "category": "Stet",
        "icon": "$(check)"
      },
      {
        "category": "Stet",
        "command": "stet.acceptOnly",
        "title": "Accept only this",
        "icon": "$(check)"
      },
      {
        "category": "Stet",
        "command": "stet.changeActions",
        "title": "More…",
        "icon": "$(ellipsis)"
      },
      {
        "command": "stet.reject",
        "title": "Reject…",
        "category": "Stet",
        "icon": "$(close)"
      },
      {
        "command": "stet.edit",
        "title": "Edit & accept…",
        "category": "Stet",
        "icon": "$(edit)"
      },
      {
        "command": "stet.comment",
        "title": "Comment…",
        "category": "Stet",
        "icon": "$(comment)"
      },
      {
        "command": "stet.revise",
        "title": "Revise…",
        "category": "Stet",
        "icon": "$(sync)"
      },
      {
        "command": "stet.acceptGroup",
        "title": "Accept all",
        "category": "Stet",
        "icon": "$(check-all)"
      },
      {
        "command": "stet.rejectGroup",
        "title": "Reject all…",
        "category": "Stet",
        "icon": "$(close-all)"
      },
      {
        "command": "stet.ungroup",
        "title": "Dissolve group",
        "category": "Stet"
      },
      {
        "command": "stet.showItem",
        "title": "Go to change",
        "category": "Stet",
        "icon": "$(go-to-file)"
      },
      {
        "command": "stet.showDiff",
        "title": "Diff",
        "category": "Stet",
        "icon": "$(diff)"
      },
      {
        "command": "stet.next",
        "title": "Next change",
        "category": "Stet",
        "icon": "$(arrow-down)"
      },
      {
        "command": "stet.previous",
        "title": "Previous change",
        "category": "Stet",
        "icon": "$(arrow-up)"
      },
      {
        "command": "stet.replyThread",
        "title": "Send to agent",
        "category": "Stet"
      },
      {
        "command": "stet.noteForAgent",
        "title": "Note for agent…",
        "category": "Stet",
        "icon": "$(note)"
      },
      {
        "command": "stet.resolveNote",
        "title": "Resolve note",
        "category": "Stet",
        "icon": "$(check)"
      },
      {
        "command": "stet.reopenNote",
        "title": "Reopen note",
        "category": "Stet",
        "icon": "$(issue-reopened)"
      },
      {
        "command": "stet.showNote",
        "title": "Go to note",
        "category": "Stet"
      },
      {
        "command": "stet.agentNotify",
        "title": "Notifications…",
        "category": "Stet",
        "icon": "$(bell)"
      },
      {
        "command": "stet.agentNotifyOff",
        "title": "Notifications (off)…",
        "category": "Stet",
        "icon": "$(bell-slash)"
      },
      {
        "command": "stet.undo",
        "title": "Undo",
        "category": "Stet",
        "icon": "$(discard)"
      },
      {
        "command": "stet.undoLast",
        "title": "Undo my last decision",
        "category": "Stet",
        "icon": "$(discard)"
      },
      {
        "command": "stet.filter",
        "title": "Filter and search…",
        "category": "Stet",
        "icon": "$(filter)"
      },
      {
        "command": "stet.clearFilter",
        "title": "Show all changes",
        "category": "Stet",
        "icon": "$(clear-all)"
      },
      {
        "command": "stet.toggleInlineChanges",
        "title": "Changes inline in the editor",
        "category": "Stet",
        "toggled": "config.stet.inlineChanges"
      },
      {
        "command": "stet.toggleCodeLens",
        "title": "Actions above changes (CodeLens)",
        "category": "Stet",
        "toggled": "config.stet.codeLens"
      },
      {
        "command": "stet.toggleAutoAdvance",
        "title": "Go to the next change after deciding",
        "category": "Stet",
        "toggled": "config.stet.autoAdvance"
      },
      {
        "category": "Stet",
        "command": "stet.toggleHighlight",
        "title": "Proposed text in green, also when it wraps",
        "toggled": "stet.highlighted"
      },
      {
        "command": "stet.longChanges.expanded",
        "title": "Long changes: open",
        "category": "Stet",
        "toggled": "config.stet.longChanges == 'expanded'"
      },
      {
        "command": "stet.longChanges.collapsed",
        "title": "Long changes: closed, open from the gutter",
        "category": "Stet",
        "toggled": "config.stet.longChanges == 'collapsed'"
      },
      {
        "command": "stet.longChanges.hover",
        "title": "Long changes: on hover only",
        "category": "Stet",
        "toggled": "config.stet.longChanges == 'hover'"
      },
      {
        "command": "stet.shareEdits.manual",
        "title": "Agents see my saved edits when I share them",
        "category": "Stet",
        "toggled": "config.stet.shareEdits == 'manual'"
      },
      {
        "command": "stet.shareEdits.saved",
        "title": "Agents see my saved edits automatically",
        "category": "Stet",
        "toggled": "config.stet.shareEdits == 'saved'"
      },
      {
        "command": "stet.shareEdits.committed",
        "title": "Agents see only committed text",
        "category": "Stet",
        "toggled": "config.stet.shareEdits == 'committed'"
      },
      {
        "command": "stet.preview",
        "title": "PDF preview",
        "category": "Stet",
        "icon": "$(file-pdf)"
      },
      {
        "command": "stet.previewSetup",
        "title": "Set up PDF previews",
        "category": "Stet"
      },
      {
        "command": "stet.agentPing",
        "title": "Notify now…",
        "category": "Stet",
        "icon": "$(megaphone)"
      },
      {
        "command": "stet.pdfPreviews.both",
        "title": "PDF previews: in the hover and the panel",
        "category": "Stet",
        "toggled": "config.stet.pdfPreviews == 'both'"
      },
      {
        "command": "stet.pdfPreviews.hover",
        "title": "PDF previews: in the hover only",
        "category": "Stet",
        "toggled": "config.stet.pdfPreviews == 'hover'"
      },
      {
        "command": "stet.pdfPreviews.panel",
        "title": "PDF previews: in the panel only",
        "category": "Stet",
        "toggled": "config.stet.pdfPreviews == 'panel'"
      },
      {
        "command": "stet.pdfPreviews.off",
        "title": "PDF previews: off",
        "category": "Stet",
        "toggled": "config.stet.pdfPreviews == 'off'"
      },
      {
        "category": "Stet",
        "command": "stet.newTextStyle.auto",
        "title": "New text: by word wrap (highlighted without, wrapping with)",
        "toggled": "config.stet.newTextStyle == 'auto'"
      },
      {
        "category": "Stet",
        "command": "stet.newTextStyle.highlighted",
        "title": "New text: highlighted, doesn't wrap",
        "toggled": "config.stet.newTextStyle == 'highlighted'"
      },
      {
        "category": "Stet",
        "command": "stet.newTextStyle.wrapping",
        "title": "New text: wraps with the line",
        "toggled": "config.stet.newTextStyle == 'wrapping'"
      },
      {
        "command": "stet.reviewFile",
        "title": "Review file",
        "category": "Stet",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "stet.reviewAccept",
        "title": "Accept (from the review)",
        "category": "Stet"
      },
      {
        "command": "stet.reviewRun",
        "title": "Run an action from the review",
        "category": "Stet"
      },
      {
        "command": "stet.editAccept",
        "title": "Accept with this wording",
        "category": "Stet",
        "icon": "$(check)"
      },
      {
        "command": "stet.editReset",
        "title": "Agent's wording",
        "category": "Stet",
        "icon": "$(discard)"
      },
      {
        "command": "stet.editSave",
        "title": "Save wording (stays pending)",
        "category": "Stet"
      },
      {
        "command": "stet.toggleDiffProposals",
        "title": "Diffs: your side shows the proposals too",
        "category": "Stet",
        "toggled": "config.stet.diffShowsProposals"
      },
      {
        "command": "stet.clearDraft",
        "title": "Use agent's wording",
        "category": "Stet",
        "icon": "$(discard)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "stet.filter",
          "when": "view == stet.review && stet.active",
          "group": "navigation@0"
        },
        {
          "command": "stet.clearFilter",
          "when": "view == stet.review && stet.filtered",
          "group": "navigation@0"
        },
        {
          "command": "stet.shareEdits",
          "when": "view == stet.review && stet.unshared",
          "group": "navigation@0"
        },
        {
          "command": "stet.undoLast",
          "when": "view == stet.review && stet.canUndo",
          "group": "navigation@1"
        },
        {
          "command": "stet.finishReview",
          "when": "view == stet.review && stet.uncommitted",
          "group": "navigation@1"
        },
        {
          "submenu": "stet.viewOptions",
          "when": "view == stet.review",
          "group": "navigation@9"
        },
        {
          "command": "stet.newAgent",
          "when": "view == stet.review && stet.active",
          "group": "1_agents@1"
        },
        {
          "command": "stet.refresh",
          "when": "view == stet.review",
          "group": "2_tools@1"
        },
        {
          "command": "stet.previewSetup",
          "when": "view == stet.review && stet.active && stet.previews",
          "group": "2_tools@2"
        },
        {
          "command": "stet.doctor",
          "when": "view == stet.review",
          "group": "2_tools@3"
        },
        {
          "command": "stet.setup",
          "when": "view == stet.review && !stet.agentWorkspace",
          "group": "2_tools@4"
        }
      ],
      "view/item/context": [
        {
          "command": "stet.showDiff",
          "when": "view == stet.review && viewItem =~ /^item/",
          "group": "inline@0"
        },
        {
          "command": "stet.accept",
          "when": "view == stet.review && viewItem =~ /^item\\.live/",
          "group": "inline@1"
        },
        {
          "command": "stet.reject",
          "when": "view == stet.review && viewItem =~ /^item\\.live/",
          "group": "inline@2"
        },
        {
          "command": "stet.accept",
          "when": "view == stet.review && viewItem =~ /^item\\.live/",
          "group": "1_decide@1"
        },
        {
          "command": "stet.reject",
          "when": "view == stet.review && viewItem =~ /^item\\.live/",
          "group": "1_decide@2"
        },
        {
          "command": "stet.edit",
          "when": "view == stet.review && viewItem =~ /^item\\.live\\.modify/",
          "group": "1_decide@3"
        },
        {
          "command": "stet.revise",
          "when": "view == stet.review && viewItem =~ /^item\\.live/",
          "group": "1_decide@4"
        },
        {
          "command": "stet.comment",
          "when": "view == stet.review && viewItem =~ /^item/",
          "group": "2_talk@1"
        },
        {
          "command": "stet.showDiff",
          "when": "view == stet.review && viewItem =~ /^item/",
          "group": "3_view@1"
        },
        {
          "command": "stet.preview",
          "when": "view == stet.review && viewItem =~ /^item\\.live\\.modify\\.pdf/",
          "group": "3_view@2"
        },
        {
          "command": "stet.reviewFile",
          "when": "view == stet.review && viewItem =~ /^item\\.live\\.modify/",
          "group": "3_view@3"
        },
        {
          "command": "stet.showItem",
          "when": "view == stet.review && viewItem =~ /^item/",
          "group": "3_view@4"
        },
        {
          "command": "stet.changeActions",
          "when": "view == stet.review && viewItem =~ /^item/",
          "group": "4_other@9"
        },
        {
          "command": "stet.showDiff",
          "when": "view == stet.history && viewItem =~ /^item/",
          "group": "inline@0"
        },
        {
          "command": "stet.undo",
          "when": "view == stet.history && viewItem =~ /\\.undo$/",
          "group": "inline@1"
        },
        {
          "command": "stet.comment",
          "when": "view == stet.history && viewItem =~ /^item/",
          "group": "2_talk@1"
        },
        {
          "command": "stet.showDiff",
          "when": "view == stet.history && viewItem =~ /^item/",
          "group": "3_view@1"
        },
        {
          "command": "stet.preview",
          "when": "view == stet.history && viewItem =~ /^item\\.done\\.modify\\.pdf/",
          "group": "3_view@2"
        },
        {
          "command": "stet.showItem",
          "when": "view == stet.history && viewItem =~ /^item/",
          "group": "3_view@4"
        },
        {
          "command": "stet.undo",
          "when": "view == stet.history && viewItem =~ /\\.undo$/",
          "group": "4_other@1"
        },
        {
          "command": "stet.acceptGroup",
          "when": "view == stet.review && viewItem =~ /^(group|part)\\.live/",
          "group": "inline@1"
        },
        {
          "command": "stet.rejectGroup",
          "when": "view == stet.review && viewItem =~ /^(group|part)\\.live/",
          "group": "inline@2"
        },
        {
          "command": "stet.acceptGroup",
          "when": "view == stet.review && viewItem =~ /^(group|part|changeset)\\.live/",
          "group": "1_decide@1"
        },
        {
          "command": "stet.rejectGroup",
          "when": "view == stet.review && viewItem =~ /^(group|part|changeset)\\.live/",
          "group": "1_decide@2"
        },
        {
          "command": "stet.ungroup",
          "when": "view == stet.review && viewItem =~ /^group/",
          "group": "2_edit@1"
        },
        {
          "command": "stet.openAgent",
          "when": "view == stet.review && viewItem =~ /^agent\\.active/",
          "group": "inline@1"
        },
        {
          "command": "stet.openAgent",
          "when": "view == stet.review && viewItem =~ /^agent\\.active/",
          "group": "1_open@1"
        },
        {
          "command": "stet.copyAgentPath",
          "when": "view == stet.review && viewItem =~ /^agent\\.active/",
          "group": "1_open@2"
        },
        {
          "command": "stet.archiveAgent",
          "when": "view == stet.review && viewItem =~ /^agent\\.active/",
          "group": "3_archive@1"
        },
        {
          "command": "stet.resolveNote",
          "when": "view == stet.review && viewItem == note.open",
          "group": "inline@1"
        },
        {
          "command": "stet.reopenNote",
          "when": "view == stet.history && viewItem == note.resolved",
          "group": "inline@1"
        },
        {
          "command": "stet.reopenNote",
          "when": "view == stet.history && viewItem == note.resolved",
          "group": "1_decide@1"
        },
        {
          "command": "stet.resolveNote",
          "when": "view == stet.review && viewItem == note.open",
          "group": "1_decide@1"
        },
        {
          "command": "stet.agentNotify",
          "when": "view == stet.review && viewItem =~ /^agent\\.active\\.notify-(now|batched)$/",
          "group": "inline@0"
        },
        {
          "command": "stet.agentNotifyOff",
          "when": "view == stet.review && viewItem =~ /^agent\\.active\\.notify-off$/",
          "group": "inline@0"
        },
        {
          "command": "stet.agentNotify",
          "when": "view == stet.review && viewItem =~ /^agent\\.active/",
          "group": "2_manage@0"
        },
        {
          "command": "stet.agentPing",
          "when": "view == stet.review && viewItem =~ /^agent\\.active/",
          "group": "2_manage@1"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "stet.replyThread",
          "group": "inline",
          "when": "commentController == stet"
        }
      ],
      "commandPalette": [
        {
          "command": "stet.setup",
          "when": "!stet.agentWorkspace"
        },
        {
          "command": "stet.reopenNote",
          "when": "false"
        },
        {
          "command": "stet.previewSetup",
          "when": "stet.active && stet.previews"
        },
        {
          "command": "stet.replyThread",
          "when": "false"
        },
        {
          "command": "stet.ungroup",
          "when": "false"
        },
        {
          "command": "stet.copyAgentPath",
          "when": "false"
        },
        {
          "command": "stet.shareEdits",
          "when": "stet.active"
        },
        {
          "command": "stet.noteForAgent",
          "when": "stet.active && editorIsOpen"
        },
        {
          "command": "stet.resolveNote",
          "when": "false"
        },
        {
          "command": "stet.showNote",
          "when": "false"
        },
        {
          "command": "stet.agentNotifyOff",
          "when": "false"
        },
        {
          "command": "stet.reviewAccept",
          "when": "false"
        },
        {
          "command": "stet.reviewRun",
          "when": "false"
        },
        {
          "command": "stet.editAccept",
          "when": "resourceScheme == stet-edit"
        },
        {
          "command": "stet.editReset",
          "when": "resourceScheme == stet-edit"
        },
        {
          "command": "stet.editSave",
          "when": "false"
        },
        {
          "command": "stet.highlightOn",
          "when": "false"
        },
        {
          "command": "stet.highlightOff",
          "when": "false"
        },
        {
          "command": "stet.acceptOnly",
          "when": "false"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "stet.resolveNote",
          "group": "inline",
          "when": "commentController == stet && commentThread =~ /^N\\d+$/"
        }
      ],
      "editor/context": [
        {
          "command": "stet.noteForAgent",
          "group": "stet@1",
          "when": "stet.active && resourceScheme == file"
        },
        {
          "command": "stet.reviewFile",
          "when": "resourceScheme == file && stet.fileHasChanges",
          "group": "stet@1"
        }
      ],
      "stet.viewOptions": [
        {
          "command": "stet.toggleInlineChanges",
          "group": "1_editor@1"
        },
        {
          "command": "stet.toggleCodeLens",
          "group": "1_editor@2"
        },
        {
          "command": "stet.toggleAutoAdvance",
          "group": "1_editor@3"
        },
        {
          "command": "stet.toggleDiffProposals",
          "group": "1_editor@4"
        },
        {
          "command": "stet.newTextStyle.auto",
          "group": "2_style@1"
        },
        {
          "command": "stet.newTextStyle.highlighted",
          "group": "2_style@2"
        },
        {
          "command": "stet.newTextStyle.wrapping",
          "group": "2_style@3"
        },
        {
          "command": "stet.toggleHighlight",
          "group": "2_style@4"
        },
        {
          "command": "stet.longChanges.expanded",
          "group": "3_long@1"
        },
        {
          "command": "stet.longChanges.collapsed",
          "group": "3_long@2"
        },
        {
          "command": "stet.longChanges.hover",
          "group": "3_long@3"
        },
        {
          "command": "stet.shareEdits.manual",
          "group": "4_share@1"
        },
        {
          "command": "stet.shareEdits.saved",
          "group": "4_share@2"
        },
        {
          "command": "stet.shareEdits.committed",
          "group": "4_share@3"
        },
        {
          "command": "stet.pdfPreviews.both",
          "group": "5_pdf@1"
        },
        {
          "command": "stet.pdfPreviews.hover",
          "group": "5_pdf@2"
        },
        {
          "command": "stet.pdfPreviews.panel",
          "group": "5_pdf@3"
        },
        {
          "command": "stet.pdfPreviews.off",
          "group": "5_pdf@4"
        }
      ],
      "editor/title": [
        {
          "command": "stet.reviewFile",
          "when": "resourceScheme == file && stet.fileHasChanges",
          "group": "navigation@1"
        },
        {
          "command": "stet.editAccept",
          "when": "resourceScheme == stet-edit",
          "group": "navigation@1"
        },
        {
          "command": "stet.editReset",
          "when": "resourceScheme == stet-edit",
          "group": "navigation@2"
        }
      ]
    },
    "keybindings": [
      {
        "key": "a",
        "command": "stet.accept",
        "when": "focusedView == stet.review && !inputFocus",
        "args": "panel"
      },
      {
        "key": "r",
        "command": "stet.reject",
        "when": "focusedView == stet.review && !inputFocus",
        "args": "panel"
      },
      {
        "key": "e",
        "command": "stet.edit",
        "when": "focusedView == stet.review && !inputFocus",
        "args": "panel"
      },
      {
        "key": "c",
        "command": "stet.comment",
        "when": "focusedView == stet.review && !inputFocus",
        "args": "panel"
      },
      {
        "key": "v",
        "command": "stet.revise",
        "when": "focusedView == stet.review && !inputFocus",
        "args": "panel"
      },
      {
        "key": "d",
        "command": "stet.showDiff",
        "when": "focusedView == stet.review && !inputFocus",
        "args": "panel"
      },
      {
        "key": "shift+a",
        "command": "stet.acceptGroup",
        "when": "focusedView == stet.review && !inputFocus",
        "args": "panel"
      },
      {
        "key": "shift+r",
        "command": "stet.rejectGroup",
        "when": "focusedView == stet.review && !inputFocus",
        "args": "panel"
      },
      {
        "key": "j",
        "command": "stet.next",
        "when": "focusedView == stet.review && !inputFocus"
      },
      {
        "key": "k",
        "command": "stet.previous",
        "when": "focusedView == stet.review && !inputFocus"
      },
      {
        "key": "p",
        "command": "stet.preview",
        "when": "focusedView == stet.review && !inputFocus",
        "args": "panel"
      },
      {
        "key": "f",
        "command": "stet.reviewFile",
        "when": "focusedView == stet.review && !inputFocus",
        "args": "panel"
      },
      {
        "key": "u",
        "command": "stet.undoLast",
        "when": "focusedView == stet.review && !inputFocus"
      },
      {
        "key": "/",
        "command": "stet.filter",
        "when": "focusedView == stet.review && !inputFocus"
      },
      {
        "key": ".",
        "command": "stet.changeActions",
        "when": "focusedView == stet.review && !inputFocus",
        "args": "panel"
      },
      {
        "key": "u",
        "command": "stet.undo",
        "when": "focusedView == stet.history && !inputFocus",
        "args": "history"
      },
      {
        "key": "d",
        "command": "stet.showDiff",
        "when": "focusedView == stet.history && !inputFocus",
        "args": "history"
      }
    ],
    "configuration": {
      "title": "Stet",
      "properties": {
        "stet.autoAdvance": {
          "type": "boolean",
          "default": true,
          "description": "After you accept, reject, edit or request a revision of a change, select the next pending change and show it."
        },
        "stet.navigationOrder": {
          "type": "string",
          "enum": [
            "panel",
            "document"
          ],
          "default": "panel",
          "enumDescriptions": [
            "j and k go to the next and previous change as the panel lists them (by agent, round and group).",
            "j and k go through the changes by file and line, as they are in your document."
          ],
          "description": "The order j and k (Next and Previous change) go through the changes in."
        },
        "stet.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show Accept, Reject… and More… above each proposed change (More… lists every action, as Ctrl+. does)."
        },
        "stet.diffShowsProposals": {
          "type": "boolean",
          "default": false,
          "description": "In Diff and Review file, show your file itself on the left: editable, with the proposals marked in it as in the editor. Off: your text as it is, read-only, with what the proposals remove in red."
        },
        "stet.inlineChanges": {
          "type": "boolean",
          "default": true,
          "description": "Show proposed changes in the editor: old text struck through, new text next to it."
        },
        "stet.longChanges": {
          "type": "string",
          "enum": [
            "expanded",
            "collapsed",
            "hover"
          ],
          "default": "collapsed",
          "enumDescriptions": [
            "Show the full new text in a panel under the change, open.",
            "The same panel, closed: click the change's marker in the gutter to open it.",
            "Only in the hover (and in Diff)."
          ],
          "description": "How proposed changes are shown whose new text is too long to show on one line in the editor."
        },
        "stet.newTextStyle": {
          "type": "string",
          "enum": [
            "auto",
            "highlighted",
            "wrapping"
          ],
          "default": "auto",
          "enumDescriptions": [
            "Highlighted when word wrap is off, wrapping when it is on.",
            "Proposed text in green. It doesn't take part in word wrap.",
            "Proposed text wraps with the line, in the colour of inlay hints (View options → Proposed text in green makes it green)."
          ],
          "description": "How proposed new text is drawn in the editor. Toggling word wrap with Alt+Z doesn't change the word wrap setting, so choose explicitly if you do that."
        },
        "stet.runtime": {
          "type": "string",
          "enum": [
            "auto",
            "node",
            "vscode"
          ],
          "default": "auto",
          "enumDescriptions": [
            "Use Node.js (≥ 20) if it is installed, otherwise VS Code's own runtime.",
            "Always use Node.js from PATH.",
            "Always use VS Code's own runtime (no Node.js needed)."
          ],
          "description": "What runs the Stet server that AI agents talk to."
        },
        "stet.shareEdits": {
          "type": "string",
          "scope": "resource",
          "enum": [
            "manual",
            "saved",
            "committed"
          ],
          "default": "manual",
          "enumDescriptions": [
            "Agents see your saved edits when you click Share my edits (the cloud button in the Stet panel's title bar).",
            "Agents see your saved edits automatically, whenever they sync.",
            "Agents see only committed text (and the changes you accepted)."
          ],
          "markdownDescription": "Which of your own edits AI agents see. Changes you accepted always reach them. Stored in the project (`.git/stet/config.json`), so it also applies to `stet` on the command line."
        },
        "stet.pdfPreviews": {
          "type": "string",
          "enum": [
            "both",
            "hover",
            "panel",
            "off"
          ],
          "default": "both",
          "enumDescriptions": [
            "In a change's hover once it is built, and in the Preview panel (PDF preview).",
            "Only in the hover.",
            "Only in the Preview panel.",
            "Not at all: nothing is compiled."
          ],
          "description": "Where PDF previews of changes are shown (LaTeX projects; Typst has none yet). They are built in the background; the change itself shows at once."
        }
      }
    },
    "configurationDefaults": {
      "[latex]": {
        "editor.inlayHints.maximumLength": 0
      },
      "[tex]": {
        "editor.inlayHints.maximumLength": 0
      },
      "[bibtex]": {
        "editor.inlayHints.maximumLength": 0
      },
      "[typst]": {
        "editor.inlayHints.maximumLength": 0
      }
    },
    "colors": [
      {
        "id": "stet.insertedText.foreground",
        "description": "Proposed new text in the editor (when drawn highlighted).",
        "defaults": {
          "dark": "#7EE2A8",
          "light": "#116329",
          "highContrast": "#7EE2A8",
          "highContrastLight": "#116329"
        }
      },
      {
        "id": "stet.insertedText.background",
        "description": "Background of proposed new text (when drawn highlighted).",
        "defaults": {
          "dark": "#2EA04333",
          "light": "#2EA04326",
          "highContrast": null,
          "highContrastLight": null
        }
      },
      {
        "id": "stet.insertedText.border",
        "description": "Border of text a change inserts. Set in high-contrast themes only, where proposed text must not rely on colour.",
        "defaults": {
          "dark": "#00000000",
          "light": "#00000000",
          "highContrast": "contrastActiveBorder",
          "highContrastLight": "contrastActiveBorder"
        }
      },
      {
        "id": "stet.removedText.foreground",
        "description": "Text a proposal removes (struck through).",
        "defaults": {
          "dark": "#FF9492",
          "light": "#B3261E",
          "highContrast": "#FF9492",
          "highContrastLight": "#B3261E"
        }
      },
      {
        "id": "stet.removedText.background",
        "description": "Background of text a proposal removes.",
        "defaults": {
          "dark": "diffEditor.removedTextBackground",
          "light": "diffEditor.removedTextBackground",
          "highContrast": null,
          "highContrastLight": null
        }
      }
    ],
    "submenus": [
      {
        "id": "stet.viewOptions",
        "label": "View options",
        "icon": "$(settings)"
      }
    ]
  },
  "preview": true
}
