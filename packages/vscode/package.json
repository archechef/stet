{
  "name": "stet-vscode",
  "displayName": "Stet",
  "description": "Review AI-proposed changes to LaTeX projects: accept, reject, edit or comment on each change.",
  "version": "0.10.0",
  "publisher": "archechef",
  "license": "MIT",
  "author": "Noah Tittelbach",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#F6F1E4",
    "theme": "light"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "latex",
    "tex",
    "overleaf",
    "review",
    "proofreading",
    "ai",
    "agent",
    "claude",
    "codex",
    "mcp"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Stet runs git in your project and writes accepted changes to your files, so it only works in folders you trust."
    },
    "virtualWorkspaces": false
  },
  "activationEvents": [
    "workspaceContains:**/*.tex",
    "onStartupFinished"
  ],
  "scripts": {
    "build": "tsc -b ../core && tsc -p . && node esbuild.mjs",
    "package": "node -e \"require('fs').copyFileSync('../../LICENSE','LICENSE')\" && npm run build && vsce package --no-dependencies --allow-missing-repository -o stet-vscode.vsix",
    "test:integration": "node test/integration/run.mjs"
  },
  "dependencies": {
    "@stet/core": "0.10.0"
  },
  "devDependencies": {
    "@types/vscode": "~1.100.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "stet",
          "title": "Stet",
          "icon": "media/stet.svg"
        }
      ]
    },
    "views": {
      "stet": [
        {
          "id": "stet.review",
          "name": "Review",
          "icon": "media/stet.svg"
        },
        {
          "id": "stet.history",
          "name": "History",
          "icon": "media/stet.svg",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "stet.review",
        "contents": "Stet is not set up for this folder yet.\n[Set up project](command:stet.setup)\nStet keeps AI agents in their own workspace and lets you review each proposed change.",
        "when": "workspaceFolderCount > 0 && !stet.active"
      },
      {
        "view": "stet.review",
        "contents": "Open the folder of your LaTeX project to use Stet.\n[Open Folder](command:vscode.openFolder)",
        "when": "workspaceFolderCount == 0"
      },
      {
        "view": "stet.review",
        "contents": "No agents yet. Create a workspace for an AI agent, then open it in the Claude desktop app, Claude Code or Codex.\n[New agent workspace](command:stet.newAgent)",
        "when": "stet.active && !stet.hasAgents"
      }
    ],
    "commands": [
      {
        "command": "stet.setup",
        "title": "Set up project",
        "category": "Stet",
        "icon": "$(add)"
      },
      {
        "command": "stet.newAgent",
        "title": "New agent workspace",
        "category": "Stet",
        "icon": "$(add)"
      },
      {
        "command": "stet.openAgent",
        "title": "Open agent workspace…",
        "category": "Stet",
        "icon": "$(folder-opened)"
      },
      {
        "command": "stet.copyAgentPath",
        "title": "Copy workspace path",
        "category": "Stet"
      },
      {
        "command": "stet.archiveAgent",
        "title": "Archive agent…",
        "category": "Stet"
      },
      {
        "command": "stet.refresh",
        "title": "Refresh",
        "category": "Stet",
        "icon": "$(refresh)"
      },
      {
        "command": "stet.doctor",
        "title": "Check setup (doctor)",
        "category": "Stet",
        "icon": "$(pulse)"
      },
      {
        "command": "stet.finishReview",
        "title": "Finish review (commit accepted changes)",
        "category": "Stet",
        "icon": "$(git-commit)"
      },
      {
        "command": "stet.shareEdits",
        "title": "Share my edits with agents",
        "category": "Stet",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "stet.highlightOn",
        "title": "Highlight proposed text in green",
        "category": "Stet",
        "icon": "$(symbol-color)"
      },
      {
        "command": "stet.highlightOff",
        "title": "Show proposed text in theme colours",
        "category": "Stet",
        "icon": "$(paintcan)"
      },
      {
        "command": "stet.accept",
        "title": "Accept",
        "category": "Stet",
        "icon": "$(check)"
      },
      {
        "command": "stet.reject",
        "title": "Reject…",
        "category": "Stet",
        "icon": "$(close)"
      },
      {
        "command": "stet.edit",
        "title": "Edit and accept…",
        "category": "Stet",
        "icon": "$(edit)"
      },
      {
        "command": "stet.comment",
        "title": "Comment…",
        "category": "Stet",
        "icon": "$(comment)"
      },
      {
        "command": "stet.revise",
        "title": "Request revision…",
        "category": "Stet",
        "icon": "$(sync)"
      },
      {
        "command": "stet.acceptGroup",
        "title": "Accept all",
        "category": "Stet",
        "icon": "$(check-all)"
      },
      {
        "command": "stet.rejectGroup",
        "title": "Reject all…",
        "category": "Stet",
        "icon": "$(close-all)"
      },
      {
        "command": "stet.ungroup",
        "title": "Dissolve group",
        "category": "Stet"
      },
      {
        "command": "stet.showItem",
        "title": "Go to change",
        "category": "Stet",
        "icon": "$(go-to-file)"
      },
      {
        "command": "stet.showDiff",
        "title": "Show diff",
        "category": "Stet",
        "icon": "$(diff)"
      },
      {
        "command": "stet.next",
        "title": "Next change",
        "category": "Stet",
        "icon": "$(arrow-down)"
      },
      {
        "command": "stet.previous",
        "title": "Previous change",
        "category": "Stet",
        "icon": "$(arrow-up)"
      },
      {
        "command": "stet.replyThread",
        "title": "Send to agent",
        "category": "Stet"
      },
      {
        "command": "stet.noteForAgent",
        "title": "Note for agent…",
        "category": "Stet",
        "icon": "$(note)"
      },
      {
        "command": "stet.resolveNote",
        "title": "Resolve note",
        "category": "Stet",
        "icon": "$(check)"
      },
      {
        "command": "stet.showNote",
        "title": "Go to note",
        "category": "Stet"
      },
      {
        "command": "stet.agentNotify",
        "title": "Notifications…",
        "category": "Stet",
        "icon": "$(bell)"
      },
      {
        "command": "stet.agentNotifyOff",
        "title": "Notifications (off)…",
        "category": "Stet",
        "icon": "$(bell-slash)"
      },
      {
        "command": "stet.undo",
        "title": "Undo decision",
        "category": "Stet",
        "icon": "$(discard)"
      },
      {
        "command": "stet.toggleInlineChanges",
        "title": "Show changes inline",
        "category": "Stet",
        "toggled": "config.stet.inlineChanges"
      },
      {
        "command": "stet.toggleCodeLens",
        "title": "Show Accept / Reject actions above changes",
        "category": "Stet",
        "toggled": "config.stet.codeLens"
      },
      {
        "command": "stet.toggleAutoAdvance",
        "title": "Go to the next change after deciding",
        "category": "Stet",
        "toggled": "config.stet.autoAdvance"
      },
      {
        "command": "stet.longChanges.expanded",
        "title": "Long changes: open",
        "category": "Stet",
        "toggled": "config.stet.longChanges == 'expanded'"
      },
      {
        "command": "stet.longChanges.collapsed",
        "title": "Long changes: closed, open from the gutter",
        "category": "Stet",
        "toggled": "config.stet.longChanges == 'collapsed'"
      },
      {
        "command": "stet.longChanges.hover",
        "title": "Long changes: on hover only",
        "category": "Stet",
        "toggled": "config.stet.longChanges == 'hover'"
      },
      {
        "command": "stet.shareEdits.manual",
        "title": "Agents see my saved edits when I share them",
        "category": "Stet",
        "toggled": "config.stet.shareEdits == 'manual'"
      },
      {
        "command": "stet.shareEdits.saved",
        "title": "Agents see my saved edits automatically",
        "category": "Stet",
        "toggled": "config.stet.shareEdits == 'saved'"
      },
      {
        "command": "stet.shareEdits.committed",
        "title": "Agents see only committed text",
        "category": "Stet",
        "toggled": "config.stet.shareEdits == 'committed'"
      },
      {
        "command": "stet.preview",
        "title": "Preview in PDF",
        "category": "Stet",
        "icon": "$(file-pdf)"
      },
      {
        "command": "stet.previewSetup",
        "title": "Set up PDF previews",
        "category": "Stet"
      },
      {
        "command": "stet.agentPing",
        "title": "Notify agent now…",
        "category": "Stet",
        "icon": "$(megaphone)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "stet.shareEdits",
          "when": "view == stet.review && stet.unshared",
          "group": "navigation@0"
        },
        {
          "command": "stet.finishReview",
          "when": "view == stet.review && stet.uncommitted",
          "group": "navigation@1"
        },
        {
          "command": "stet.newAgent",
          "when": "view == stet.review && stet.active",
          "group": "navigation@2"
        },
        {
          "command": "stet.refresh",
          "when": "view == stet.review",
          "group": "navigation@5"
        },
        {
          "command": "stet.doctor",
          "when": "view == stet.review",
          "group": "more@1"
        },
        {
          "command": "stet.setup",
          "when": "view == stet.review",
          "group": "more@2"
        },
        {
          "command": "stet.highlightOn",
          "when": "view == stet.review && stet.active && !stet.highlighted",
          "group": "navigation@3"
        },
        {
          "command": "stet.highlightOff",
          "when": "view == stet.review && stet.highlighted",
          "group": "navigation@3"
        },
        {
          "submenu": "stet.viewOptions",
          "when": "view == stet.review",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "stet.accept",
          "when": "view == stet.review && viewItem =~ /^item\\.live/",
          "group": "inline@1"
        },
        {
          "command": "stet.reject",
          "when": "view == stet.review && viewItem =~ /^item\\.live/",
          "group": "inline@2"
        },
        {
          "command": "stet.showDiff",
          "when": "view == stet.review && viewItem =~ /^item/",
          "group": "inline@0"
        },
        {
          "command": "stet.accept",
          "when": "view == stet.review && viewItem =~ /^item\\.live/",
          "group": "1_review@1"
        },
        {
          "command": "stet.edit",
          "when": "view == stet.review && viewItem =~ /^item\\.live\\.modify/",
          "group": "1_review@2"
        },
        {
          "command": "stet.reject",
          "when": "view == stet.review && viewItem =~ /^item\\.live/",
          "group": "1_review@3"
        },
        {
          "command": "stet.revise",
          "when": "view == stet.review && viewItem =~ /^item\\.live/",
          "group": "1_review@4"
        },
        {
          "command": "stet.comment",
          "when": "view == stet.review && viewItem =~ /^item/",
          "group": "2_talk@1"
        },
        {
          "command": "stet.showItem",
          "when": "view == stet.review && viewItem =~ /^item/",
          "group": "3_nav@1"
        },
        {
          "command": "stet.showDiff",
          "when": "view == stet.review && viewItem =~ /^item/",
          "group": "3_nav@2"
        },
        {
          "command": "stet.acceptGroup",
          "when": "view == stet.review && viewItem =~ /^(group|part)\\.live/",
          "group": "inline@1"
        },
        {
          "command": "stet.rejectGroup",
          "when": "view == stet.review && viewItem =~ /^(group|part)\\.live/",
          "group": "inline@2"
        },
        {
          "command": "stet.acceptGroup",
          "when": "view == stet.review && viewItem =~ /^(group|part|changeset)\\.live/",
          "group": "1_review@1"
        },
        {
          "command": "stet.rejectGroup",
          "when": "view == stet.review && viewItem =~ /^(group|part|changeset)\\.live/",
          "group": "1_review@2"
        },
        {
          "command": "stet.ungroup",
          "when": "view == stet.review && viewItem =~ /^group/",
          "group": "2_edit@1"
        },
        {
          "command": "stet.openAgent",
          "when": "view == stet.review && viewItem =~ /^agent\\.active/",
          "group": "inline@1"
        },
        {
          "command": "stet.openAgent",
          "when": "view == stet.review && viewItem =~ /^agent\\.active/",
          "group": "1_open@1"
        },
        {
          "command": "stet.copyAgentPath",
          "when": "view == stet.review && viewItem =~ /^agent\\.active/",
          "group": "1_open@2"
        },
        {
          "command": "stet.archiveAgent",
          "when": "view == stet.review && viewItem =~ /^agent\\.active/",
          "group": "2_manage@1"
        },
        {
          "command": "stet.showDiff",
          "when": "view == stet.history && viewItem =~ /^item/",
          "group": "inline"
        },
        {
          "command": "stet.showDiff",
          "when": "view == stet.history && viewItem =~ /^item/",
          "group": "1_view@1"
        },
        {
          "command": "stet.showItem",
          "when": "view == stet.history && viewItem =~ /^item/",
          "group": "1_view@2"
        },
        {
          "command": "stet.comment",
          "when": "view == stet.history && viewItem =~ /^item/",
          "group": "2_talk@1"
        },
        {
          "command": "stet.resolveNote",
          "when": "view == stet.review && viewItem == note.open",
          "group": "inline@1"
        },
        {
          "command": "stet.resolveNote",
          "when": "view == stet.review && viewItem == note.open",
          "group": "1_review@1"
        },
        {
          "command": "stet.agentNotify",
          "when": "view == stet.review && viewItem =~ /^agent\\.active\\.notify-(now|batched)$/",
          "group": "inline@0"
        },
        {
          "command": "stet.agentNotifyOff",
          "when": "view == stet.review && viewItem =~ /^agent\\.active\\.notify-off$/",
          "group": "inline@0"
        },
        {
          "command": "stet.agentNotify",
          "when": "view == stet.review && viewItem =~ /^agent\\.active/",
          "group": "2_manage@0"
        },
        {
          "command": "stet.undo",
          "when": "view == stet.history && viewItem =~ /\\.undo$/",
          "group": "inline@1"
        },
        {
          "command": "stet.undo",
          "when": "view == stet.history && viewItem =~ /\\.undo$/",
          "group": "1_view@3"
        },
        {
          "command": "stet.undo",
          "when": "view == stet.review && viewItem =~ /\\.undo$/",
          "group": "1_review@5"
        },
        {
          "command": "stet.preview",
          "when": "view == stet.review && viewItem =~ /^item\\.live\\.modify/",
          "group": "3_nav@3"
        },
        {
          "command": "stet.preview",
          "when": "view == stet.history && viewItem =~ /^item\\.done\\.modify/",
          "group": "1_view@4"
        },
        {
          "command": "stet.agentPing",
          "when": "view == stet.review && viewItem =~ /^agent\\.active/",
          "group": "inline@0"
        },
        {
          "command": "stet.agentPing",
          "when": "view == stet.review && viewItem =~ /^agent\\.active/",
          "group": "2_manage@0"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "stet.replyThread",
          "group": "inline",
          "when": "commentController == stet"
        }
      ],
      "commandPalette": [
        {
          "command": "stet.replyThread",
          "when": "false"
        },
        {
          "command": "stet.ungroup",
          "when": "false"
        },
        {
          "command": "stet.copyAgentPath",
          "when": "false"
        },
        {
          "command": "stet.shareEdits",
          "when": "stet.active"
        },
        {
          "command": "stet.highlightOn",
          "when": "stet.active && !stet.highlighted"
        },
        {
          "command": "stet.highlightOff",
          "when": "stet.highlighted"
        },
        {
          "command": "stet.noteForAgent",
          "when": "stet.active && editorIsOpen"
        },
        {
          "command": "stet.resolveNote",
          "when": "false"
        },
        {
          "command": "stet.showNote",
          "when": "false"
        },
        {
          "command": "stet.agentNotifyOff",
          "when": "false"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "stet.resolveNote",
          "group": "inline",
          "when": "commentController == stet && commentThread =~ /^N\\d+$/"
        }
      ],
      "editor/context": [
        {
          "command": "stet.noteForAgent",
          "group": "stet@1",
          "when": "stet.active && resourceScheme == file"
        }
      ],
      "stet.viewOptions": [
        {
          "command": "stet.toggleInlineChanges",
          "group": "1_editor@1"
        },
        {
          "command": "stet.toggleCodeLens",
          "group": "1_editor@2"
        },
        {
          "command": "stet.toggleAutoAdvance",
          "group": "1_editor@3"
        },
        {
          "command": "stet.longChanges.expanded",
          "group": "2_long@1"
        },
        {
          "command": "stet.longChanges.collapsed",
          "group": "2_long@2"
        },
        {
          "command": "stet.longChanges.hover",
          "group": "2_long@3"
        },
        {
          "command": "stet.shareEdits.manual",
          "group": "3_share@1"
        },
        {
          "command": "stet.shareEdits.saved",
          "group": "3_share@2"
        },
        {
          "command": "stet.shareEdits.committed",
          "group": "3_share@3"
        }
      ]
    },
    "keybindings": [
      {
        "key": "a",
        "command": "stet.accept",
        "when": "focusedView == stet.review && !inputFocus"
      },
      {
        "key": "r",
        "command": "stet.reject",
        "when": "focusedView == stet.review && !inputFocus"
      },
      {
        "key": "e",
        "command": "stet.edit",
        "when": "focusedView == stet.review && !inputFocus"
      },
      {
        "key": "c",
        "command": "stet.comment",
        "when": "focusedView == stet.review && !inputFocus"
      },
      {
        "key": "v",
        "command": "stet.revise",
        "when": "focusedView == stet.review && !inputFocus"
      },
      {
        "key": "d",
        "command": "stet.showDiff",
        "when": "focusedView == stet.review && !inputFocus"
      },
      {
        "key": "shift+a",
        "command": "stet.acceptGroup",
        "when": "focusedView == stet.review && !inputFocus"
      },
      {
        "key": "shift+r",
        "command": "stet.rejectGroup",
        "when": "focusedView == stet.review && !inputFocus"
      },
      {
        "key": "j",
        "command": "stet.next",
        "when": "focusedView == stet.review && !inputFocus"
      },
      {
        "key": "k",
        "command": "stet.previous",
        "when": "focusedView == stet.review && !inputFocus"
      }
    ],
    "configuration": {
      "title": "Stet",
      "properties": {
        "stet.autoAdvance": {
          "type": "boolean",
          "default": true,
          "description": "After you accept, reject, edit or request a revision of a change, select the next pending change and show it."
        },
        "stet.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show Accept / Reject / Edit / Comment actions above each proposed change."
        },
        "stet.inlineChanges": {
          "type": "boolean",
          "default": true,
          "description": "Show proposed changes inline in the editor (old text struck through, new text as ghost text)."
        },
        "stet.longChanges": {
          "type": "string",
          "enum": [
            "expanded",
            "collapsed",
            "hover"
          ],
          "default": "collapsed",
          "enumDescriptions": [
            "Show the full new text in a panel under the change, open.",
            "The same panel, closed: click the change's marker in the gutter to open it.",
            "Only in the hover (and in Show diff)."
          ],
          "description": "How proposed changes are shown whose new text is too long for one line of grey text."
        },
        "stet.newTextStyle": {
          "type": "string",
          "enum": [
            "auto",
            "highlighted",
            "wrapping"
          ],
          "default": "auto",
          "enumDescriptions": [
            "Highlighted when word wrap is off, wrapping when it is on.",
            "Proposed text in green. It doesn't take part in word wrap.",
            "Proposed text wraps with the line, in the colour of inlay hints (the panel's colour button makes them green)."
          ],
          "description": "How proposed new text is drawn in the editor. Toggling word wrap with Alt+Z doesn't change the word wrap setting, so choose explicitly if you do that."
        },
        "stet.runtime": {
          "type": "string",
          "enum": [
            "auto",
            "node",
            "vscode"
          ],
          "default": "auto",
          "enumDescriptions": [
            "Use Node.js (≥ 20) if it is installed, otherwise VS Code's own runtime.",
            "Always use Node.js from PATH.",
            "Always use VS Code's own runtime (no Node.js needed)."
          ],
          "description": "What runs the Stet server that AI agents talk to."
        },
        "stet.shareEdits": {
          "type": "string",
          "enum": [
            "manual",
            "saved",
            "committed"
          ],
          "default": "manual",
          "enumDescriptions": [
            "Agents see your saved edits when you click Share my edits (in the Stet panel or status bar).",
            "Agents see your saved edits automatically, whenever they sync.",
            "Agents see only committed text (and the changes you accepted)."
          ],
          "markdownDescription": "Which of your own edits AI agents see. Changes you accepted always reach them. Stored in the project (`.git/stet/config.json`), so it also applies to `stet` on the command line."
        }
      }
    },
