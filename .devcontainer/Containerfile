# Development container for Stet, made for rootless Podman (see CONTRIBUTING.md, "Working in a
# container"). Node.js, npm, node_modules, npm's cache and every package's install scripts stay in
# here; only the repository folder is shared with your machine.
#
# Node 22: the oldest version the tests run on (CI also tests 24). For reproducible builds, replace
# the tag with the digest you pulled: `podman image inspect --format '{{.Digest}}' node:22-bookworm`.
FROM docker.io/library/node:22-bookworm

# git and sh are in the image already; build, unit tests and packaging need nothing else.
# (The VS Code integration test needs VS Code and a display: it is not run in here.)

# No pushing from inside the container: git rewrites GitHub push URLs to a scheme that doesn't
# exist, so `git push` fails here even if credentials were forwarded by mistake. Fetching,
# committing and tagging work as usual; push from your own terminal.
RUN git config --system url."no-push-from-the-container://".pushInsteadOf "git@github.com:" \
 && git config --system --add url."no-push-from-the-container://".pushInsteadOf "ssh://git@github.com/" \
 && git config --system --add url."no-push-from-the-container://".pushInsteadOf "https://github.com/"

USER node
